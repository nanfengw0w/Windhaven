{
  "name": "windhaven-valley",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windhaven Valley (风栖谷), a procedural Three.js weather landscape maintained as scoped ES modules.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:static": "node tooling/verify-static.mjs",
    "baseline:update": "node tooling/build-baseline.mjs",
    "test": "npm run check:static"
  },
  "devDependencies": {
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.6",
    "esbuild": "0.28.2",
    "meshoptimizer": "^1.3.0",
    "prettier": "3.9.10",
    "three": "0.186.0",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@manycore/aholo-sdk-lux3d": "^1.9.0",
    "adm-zip": "^0.6.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
